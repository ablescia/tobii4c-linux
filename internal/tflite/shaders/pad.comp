#version 450
// Padding costante di un tensore H×W×C.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256) in;
layout(push_constant) uniform P {
	uint IH, IW, IC, OH, OW, OC, PT, PL, PC, x, y, value;
} p;

void main() {
	uint idx = linearID(256u);
	if (idx >= p.OH * p.OW * p.OC) return;
	uint c = idx % p.OC, pix = idx / p.OC;
	uint ox = pix % p.OW, oy = pix / p.OW;
	int iy = int(oy) - int(p.PT), ix = int(ox) - int(p.PL), ic = int(c) - int(p.PC);
	float v = uintBitsToFloat(p.value);
	if (iy >= 0 && iy < int(p.IH) && ix >= 0 && ix < int(p.IW) && ic >= 0 && ic < int(p.IC))
		v = A[p.x + (uint(iy) * p.IW + uint(ix)) * p.IC + uint(ic)];
	A[p.y + idx] = v;
}
