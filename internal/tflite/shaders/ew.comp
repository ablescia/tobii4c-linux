#version 450
// Operazioni elemento per elemento: binarie (b ripetuto ogni nb elementi:
// broadcast su canale o scalare) o un'attivazione di x.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256) in;
layout(push_constant) uniform P {
	uint n, x, b, y, nb, op, act1;
} p;

void main() {
	uint i = linearID(256u);
	if (i >= p.n) return;
	float a = A[p.x + i];
	float v;
	if (p.op == 0u) v = a + A[p.b + i % p.nb];
	else if (p.op == 1u) v = a * A[p.b + i % p.nb];
	else if (p.op == 2u) v = a - A[p.b + i % p.nb];
	else if (p.op == 3u) v = a / A[p.b + i % p.nb];
	else v = a;
	A[p.y + i] = act(v, p.act1);
}
