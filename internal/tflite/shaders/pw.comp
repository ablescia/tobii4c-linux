#version 450
// Convoluzione 1×1 a passo 1 come prodotto di matrici:
// Y[M][N] = X[M][K] · W[K][N] + bias, con le attivazioni e la somma
// residua fuse. Tile 64×64 per workgroup, 4×4 uscite per thread.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform P {
	uint M, K, N, x, w, b, y, res, act1, act2;
} p;

shared float As[16][64];
shared float Bs[16][64];

void main() {
	uint tx = gl_LocalInvocationID.x, ty = gl_LocalInvocationID.y;
	uint t = ty * 16u + tx;
	uint m0 = gl_WorkGroupID.y * 64u, n0 = gl_WorkGroupID.x * 64u;
	float acc[4][4];
	for (int i = 0; i < 4; i++)
		for (int j = 0; j < 4; j++) acc[i][j] = 0.0;

	for (uint k0 = 0u; k0 < p.K; k0 += 16u) {
		for (uint e = 0u; e < 4u; e++) {
			uint idx = t + 256u * e;
			uint mm = idx / 16u, kk = idx % 16u;
			uint gm = m0 + mm, gk = k0 + kk;
			As[kk][mm] = (gm < p.M && gk < p.K) ? A[p.x + gm * p.K + gk] : 0.0;
			uint kb = idx / 64u, nb = idx % 64u;
			uint gkb = k0 + kb, gn = n0 + nb;
			Bs[kb][nb] = (gkb < p.K && gn < p.N) ? A[p.w + gkb * p.N + gn] : 0.0;
		}
		barrier();
		for (uint k = 0u; k < 16u; k++) {
			float a0 = As[k][ty], a1 = As[k][ty + 16u], a2 = As[k][ty + 32u], a3 = As[k][ty + 48u];
			float b0 = Bs[k][tx], b1 = Bs[k][tx + 16u], b2 = Bs[k][tx + 32u], b3 = Bs[k][tx + 48u];
			acc[0][0] += a0 * b0; acc[0][1] += a0 * b1; acc[0][2] += a0 * b2; acc[0][3] += a0 * b3;
			acc[1][0] += a1 * b0; acc[1][1] += a1 * b1; acc[1][2] += a1 * b2; acc[1][3] += a1 * b3;
			acc[2][0] += a2 * b0; acc[2][1] += a2 * b1; acc[2][2] += a2 * b2; acc[2][3] += a2 * b3;
			acc[3][0] += a3 * b0; acc[3][1] += a3 * b1; acc[3][2] += a3 * b2; acc[3][3] += a3 * b3;
		}
		barrier();
	}
	for (uint i = 0u; i < 4u; i++) {
		uint gm = m0 + ty + 16u * i;
		if (gm >= p.M) continue;
		for (uint j = 0u; j < 4u; j++) {
			uint gn = n0 + tx + 16u * j;
			if (gn >= p.N) continue;
			float v = acc[i][j];
			if (p.b != NONE) v += A[p.b + gn];
			v = act(v, p.act1);
			uint o = gm * p.N + gn;
			if (p.res != NONE) v = act(v + A[p.res + o], p.act2);
			A[p.y + o] = v;
		}
	}
}
