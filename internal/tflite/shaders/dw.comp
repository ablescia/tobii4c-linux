#version 450
// Convoluzione depthwise (moltiplicatore 1, pesi [KH][KW][C]).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 64) in;
layout(push_constant) uniform P {
	uint IH, IW, C, OH, OW, KH, KW, SH, SW, PT, PL, DH, DW;
	uint x, w, b, y, res, act1, act2;
} p;

void main() {
	uint idx = linearID(64u);
	if (idx >= p.OH * p.OW * p.C) return;
	uint c = idx % p.C, pix = idx / p.C;
	uint ox = pix % p.OW, oy = pix / p.OW;
	float s = (p.b != NONE) ? A[p.b + c] : 0.0;
	for (uint kh = 0u; kh < p.KH; kh++) {
		int iy = int(oy * p.SH + kh * p.DH) - int(p.PT);
		if (iy < 0 || iy >= int(p.IH)) continue;
		for (uint kw = 0u; kw < p.KW; kw++) {
			int ix = int(ox * p.SW + kw * p.DW) - int(p.PL);
			if (ix < 0 || ix >= int(p.IW)) continue;
			s += A[p.x + (uint(iy) * p.IW + uint(ix)) * p.C + c] * A[p.w + (kh * p.KW + kw) * p.C + c];
		}
	}
	s = act(s, p.act1);
	if (p.res != NONE) s = act(s + A[p.res + idx], p.act2);
	A[p.y + idx] = s;
}
