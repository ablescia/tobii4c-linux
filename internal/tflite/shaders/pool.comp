#version 450
// Pooling massimo o medio (la media conta solo i pixel dentro l'immagine).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 64) in;
layout(push_constant) uniform P {
	uint IH, IW, C, OH, OW, KH, KW, SH, SW, PT, PL, x, y, isMax, act1;
} p;

void main() {
	uint idx = linearID(64u);
	if (idx >= p.OH * p.OW * p.C) return;
	uint c = idx % p.C, pix = idx / p.C;
	uint ox = pix % p.OW, oy = pix / p.OW;
	float s = (p.isMax != 0u) ? -3.402823466e38 : 0.0;
	uint n = 0u;
	for (uint kh = 0u; kh < p.KH; kh++) {
		int iy = int(oy * p.SH + kh) - int(p.PT);
		if (iy < 0 || iy >= int(p.IH)) continue;
		for (uint kw = 0u; kw < p.KW; kw++) {
			int ix = int(ox * p.SW + kw) - int(p.PL);
			if (ix < 0 || ix >= int(p.IW)) continue;
			float v = A[p.x + (uint(iy) * p.IW + uint(ix)) * p.C + c];
			s = (p.isMax != 0u) ? max(s, v) : s + v;
			n++;
		}
	}
	if (p.isMax == 0u && n > 0u) s /= float(n);
	A[p.y + idx] = act(s, p.act1);
}
