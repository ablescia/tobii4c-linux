#version 450
// Dall'immagine della webcam (piani YCbCr a 8 bit, o solo Y) al tensore
// d'ingresso RGB OH×OW×3: trasformazione affine dal pixel del tensore al
// pixel dell'immagine (centri dei pixel sugli interi, come OpenCV),
// interpolazione bilineare in RGB, bordo nero o replicato, valori portati
// nell'intervallo [lo, hi].
//
// Parametri nel buffer dell'immagine (parole a partire da p.slot):
//  0 W, 1 H, 2 offset di Y (byte), 3 CW, 4 CH, 5 offset di Cb, 6 offset di Cr,
//  7 flag (1: crominanza, 2: bordo replicato), 8..13 matrice, 14 lo, 15 hi.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform P {
	uint slot, y, OW, OH;
} p;

uint byteAt(uint off) {
	return (IMG[off >> 2] >> ((off & 3u) * 8u)) & 0xffu;
}

uint W, H, YO, CW, CH, CBO, CRO, FL;

vec3 rgbAt(int ix, int iy) {
	if ((FL & 2u) != 0u) {
		ix = clamp(ix, 0, int(W) - 1);
		iy = clamp(iy, 0, int(H) - 1);
	} else if (ix < 0 || iy < 0 || ix >= int(W) || iy >= int(H)) {
		return vec3(0.0);
	}
	float Y = float(byteAt(YO + uint(iy) * W + uint(ix)));
	if ((FL & 1u) == 0u) return vec3(Y);
	uint cx = uint(ix) * CW / W, cy = uint(iy) * CH / H;
	float cb = float(byteAt(CBO + cy * CW + cx)) - 128.0;
	float cr = float(byteAt(CRO + cy * CW + cx)) - 128.0;
	return clamp(vec3(Y + 1.402 * cr, Y - 0.344136 * cb - 0.714136 * cr, Y + 1.772 * cb), 0.0, 255.0);
}

void main() {
	uint ox = gl_GlobalInvocationID.x, oy = gl_GlobalInvocationID.y;
	if (ox >= p.OW || oy >= p.OH) return;
	uint s = p.slot;
	W = IMG[s]; H = IMG[s + 1u]; YO = IMG[s + 2u]; CW = IMG[s + 3u]; CH = IMG[s + 4u];
	CBO = IMG[s + 5u]; CRO = IMG[s + 6u]; FL = IMG[s + 7u];
	float m0 = uintBitsToFloat(IMG[s + 8u]), m1 = uintBitsToFloat(IMG[s + 9u]), m2 = uintBitsToFloat(IMG[s + 10u]);
	float m3 = uintBitsToFloat(IMG[s + 11u]), m4 = uintBitsToFloat(IMG[s + 12u]), m5 = uintBitsToFloat(IMG[s + 13u]);
	float lo = uintBitsToFloat(IMG[s + 14u]), hi = uintBitsToFloat(IMG[s + 15u]);
	float sx = m0 * float(ox) + m1 * float(oy) + m2;
	float sy = m3 * float(ox) + m4 * float(oy) + m5;
	float fx = floor(sx), fy = floor(sy);
	int x0 = int(fx), y0 = int(fy);
	float dx = sx - fx, dy = sy - fy;
	vec3 c = rgbAt(x0, y0) * (1.0 - dx) * (1.0 - dy) + rgbAt(x0 + 1, y0) * dx * (1.0 - dy) +
		rgbAt(x0, y0 + 1) * (1.0 - dx) * dy + rgbAt(x0 + 1, y0 + 1) * dx * dy;
	c = c * ((hi - lo) / 255.0) + lo;
	uint o = p.y + (oy * p.OW + ox) * 3u;
	A[o] = c.r;
	A[o + 1u] = c.g;
	A[o + 2u] = c.b;
}
